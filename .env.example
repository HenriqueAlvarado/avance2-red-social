# ── Copia este archivo como .env y rellena los valores reales ───────────────
# NUNCA subas .env al repositorio

# Flask
SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria

# Base de datos RDS (PostgreSQL)
DB_HOST=tu-endpoint-rds.amazonaws.com
DB_PORT=5432
DB_NAME=redsocial
DB_USER=admin
DB_PASSWORD=tu_password_seguro

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
FEED_CACHE_TTL=60

# AWS S3
S3_BUCKET=tu-bucket-avance2
AWS_REGION=us-east-1

# Credenciales AWS (solo para producción en EC2 usa IAM Role, no estas variables)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
